# Test seed in the shape of Postfix's stock master.cf. Every render starts from
# a copy of this file, and a render without METRICS_PORT must leave it unchanged.
#
# service type  private unpriv  chroot  wakeup  maxproc command + args
smtp      inet  n       -       n       -       -       smtpd
pickup    unix  n       -       n       60      1       pickup
cleanup   unix  n       -       n       -       0       cleanup
qmgr      unix  n       -       n       300     1       qmgr
showq     unix  n       -       n       -       -       showq
smtp      unix  -       -       n       -       -       smtp
